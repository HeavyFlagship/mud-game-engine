{
  "id": "vehicles",
  "nameZh": "载具库",
  "description": "玩家载具（机体）数据（结构/装甲/速度/接口/装备舱/核心兼容等属性）",
  "globalVar": "VehicleDB",
  "dataFile": "vehicles.json",
  "primaryKey": "id",
  "recordNameZh": "载具",
  "structure": "records",
  "fields": [
    {
      "name": "id",
      "nameZh": "载具标识",
      "comment": "载具唯一标识符（英文下划线格式，如 scout），同时作为记录键",
      "type": "string",
      "required": true,
      "default": "",
      "options": [],
      "refDatabase": null,
      "scope": null
    },
    {
      "name": "name",
      "nameZh": "载具名称",
      "comment": "载具的中文名称（如 侦察机体 MK-I）",
      "type": "string",
      "required": true,
      "default": "",
      "options": [],
      "refDatabase": null,
      "scope": null
    },
    {
      "name": "type",
      "nameZh": "载具类型",
      "comment": "载具类型标识，当前数据全部为 机体（设计书另有 机甲/战车/飞行器 类型可扩展）",
      "type": "enum",
      "required": true,
      "default": "机体",
      "options": ["机体"],
      "refDatabase": null,
      "scope": null
    },
    {
      "name": "chassis",
      "nameZh": "底盘结构",
      "comment": "底盘结构类型：biped 双足 / quad 四足",
      "type": "enum",
      "required": true,
      "default": "biped",
      "options": ["biped", "quad"],
      "refDatabase": null,
      "scope": null
    },
    {
      "name": "maxHp",
      "nameZh": "结构值上限",
      "comment": "载具本体耐久度（结构值）上限，归零则机体损毁",
      "type": "number",
      "required": true,
      "default": 0,
      "options": [],
      "refDatabase": null,
      "scope": null
    },
    {
      "name": "maxArmor",
      "nameZh": "装甲值上限",
      "comment": "外部装甲层防护的装甲值上限，优先于结构值被消耗",
      "type": "number",
      "required": true,
      "default": 0,
      "options": [],
      "refDatabase": null,
      "scope": null
    },
    {
      "name": "maxSpeed",
      "nameZh": "最大速度",
      "comment": "平坦地面的基础移动速率，单位：米/秒",
      "type": "number",
      "required": true,
      "default": 0,
      "options": [],
      "refDatabase": null,
      "scope": null
    },
    {
      "name": "weight",
      "nameZh": "机体重量",
      "comment": "载具自身质量（不含装备与货物），单位：千克（kg）",
      "type": "number",
      "required": true,
      "default": 0,
      "options": [],
      "refDatabase": null,
      "scope": null
    },
    {
      "name": "overweightCoeff",
      "nameZh": "超重系数",
      "comment": "超重惩罚系数：载具加装备总重超过阈值后按此系数衰减速度与通过能力（越小惩罚越轻）",
      "type": "number",
      "required": true,
      "default": 1,
      "options": [],
      "refDatabase": null,
      "scope": null
    },
    {
      "name": "visionRadius",
      "nameZh": "视野半径",
      "comment": "载具的基础目视/观察范围，单位：米",
      "type": "number",
      "required": true,
      "default": 0,
      "options": [],
      "refDatabase": null,
      "scope": null
    },
    {
      "name": "signalRadius",
      "nameZh": "信号半径",
      "comment": "雷达探测的等效半径（对敌方信号的探测能力），单位：米",
      "type": "number",
      "required": true,
      "default": 0,
      "options": [],
      "refDatabase": null,
      "scope": null
    },
    {
      "name": "targetRadius",
      "nameZh": "目标半径",
      "comment": "目视等效的目标锁定半径（命中判定相关），单位：米",
      "type": "number",
      "required": true,
      "default": 0,
      "options": [],
      "refDatabase": null,
      "scope": null
    },
    {
      "name": "interfaces",
      "nameZh": "接口列表",
      "comment": "装备安装接口列表，数组元素结构 {types: 接口类型数组（元素如 外部/内部/电源/数据/弹药管道/离子管道/界面）, count: 该类接口的数量}",
      "type": "array",
      "required": true,
      "default": [],
      "options": [],
      "refDatabase": null,
      "scope": null
    },
    {
      "name": "equipmentBay",
      "nameZh": "装备舱容量",
      "comment": "可容纳装备的总体积上限（所有装备 bayReq 之和不得超过），单位：立方米（m³）",
      "type": "number",
      "required": true,
      "default": 0,
      "options": [],
      "refDatabase": null,
      "scope": null
    },
    {
      "name": "cargo",
      "nameZh": "货舱容量",
      "comment": "货舱容量，可携带货物（资源/物品）的总体积上限，单位：立方米（m³）",
      "type": "number",
      "required": true,
      "default": 0,
      "options": [],
      "refDatabase": null,
      "scope": null
    },
    {
      "name": "defaultWeapons",
      "nameZh": "默认武器",
      "comment": "新载具初始配备的武器列表，数组元素为武器装备 id（引用 equipment 库主键，type=weapon）",
      "type": "array",
      "required": true,
      "default": [],
      "options": [],
      "refDatabase": null,
      "scope": null
    },
    {
      "name": "defaultArmor",
      "nameZh": "默认装甲",
      "comment": "新载具初始配备的装甲列表，数组元素为装甲装备 id（引用 equipment 库主键，type=armor）",
      "type": "array",
      "required": true,
      "default": [],
      "options": [],
      "refDatabase": null,
      "scope": null
    },
    {
      "name": "energyCapacity",
      "nameZh": "能量容量",
      "comment": "载具能量资源点数的储存上限（类比 MP 上限）",
      "type": "number",
      "required": true,
      "default": 0,
      "options": [],
      "refDatabase": null,
      "scope": null
    },
    {
      "name": "energyRegen",
      "nameZh": "能量恢复",
      "comment": "每秒自然恢复的能量资源点数",
      "type": "number",
      "required": true,
      "default": 0,
      "options": [],
      "refDatabase": null,
      "scope": null
    },
    {
      "name": "price",
      "nameZh": "购买价格",
      "comment": "购买该载具的价格，单位：信用点；初始配发载具为 0",
      "type": "number",
      "required": true,
      "default": 0,
      "options": [],
      "refDatabase": null,
      "scope": null
    },
    {
      "name": "compatibleComputers",
      "nameZh": "兼容计算机",
      "comment": "可安装的核心计算机列表，数组元素为核心计算机装备 id（引用 equipment 库主键，coreType=computer）",
      "type": "array",
      "required": true,
      "default": [],
      "options": [],
      "refDatabase": null,
      "scope": null
    },
    {
      "name": "compatiblePowers",
      "nameZh": "兼容动力",
      "comment": "可安装的核心动力列表，数组元素为核心动力装备 id（引用 equipment 库主键，coreType=power）",
      "type": "array",
      "required": true,
      "default": [],
      "options": [],
      "refDatabase": null,
      "scope": null
    },
    {
      "name": "defaultCoreComputer",
      "nameZh": "默认核心计算机",
      "comment": "新载具默认安装的核心计算机装备 id（引用 equipment 库主键，coreType=computer），核心舱必装模块",
      "type": "ref",
      "required": true,
      "default": "",
      "options": [],
      "refDatabase": "equipment",
      "scope": null
    },
    {
      "name": "defaultCorePower",
      "nameZh": "默认核心动力",
      "comment": "新载具默认安装的核心动力装备 id（引用 equipment 库主键，coreType=power），核心舱必装模块",
      "type": "ref",
      "required": true,
      "default": "",
      "options": [],
      "refDatabase": "equipment",
      "scope": null
    },
    {
      "name": "desc",
      "nameZh": "描述",
      "comment": "载具的定位与特点描述文本",
      "type": "string",
      "required": true,
      "default": "",
      "options": [],
      "refDatabase": null,
      "scope": null
    }
  ]
}
