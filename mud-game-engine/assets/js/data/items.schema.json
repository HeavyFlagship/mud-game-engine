{
  "id": "items",
  "nameZh": "物品库",
  "description": "非装备类物品数据（消耗品：修复包/装甲补片/能量电池等，原 consumables/questItems 嵌套已平铺）",
  "globalVar": "ItemDB",
  "dataFile": "items.json",
  "primaryKey": "id",
  "recordNameZh": "物品",
  "structure": "records",
  "fields": [
    {
      "name": "id",
      "nameZh": "物品标识",
      "comment": "物品唯一标识符（英文下划线格式，如 repair_kit_small），同时作为记录键",
      "type": "string",
      "required": true,
      "default": "",
      "options": [],
      "refDatabase": null,
      "scope": null
    },
    {
      "name": "name",
      "nameZh": "物品名称",
      "comment": "物品的中文名称（如 小型修复包）",
      "type": "string",
      "required": true,
      "default": "",
      "options": [],
      "refDatabase": null,
      "scope": null
    },
    {
      "name": "type",
      "nameZh": "物品类型",
      "comment": "物品类型标识，当前数据全部为 consumable（战斗消耗品）",
      "type": "enum",
      "required": true,
      "default": "consumable",
      "options": ["consumable"],
      "refDatabase": null,
      "scope": null
    },
    {
      "name": "healHp",
      "nameZh": "恢复结构值",
      "comment": "使用后恢复的载具结构值（HP），单位：点",
      "type": "number",
      "required": false,
      "default": 0,
      "options": [],
      "refDatabase": null,
      "scope": "仅治疗类消耗品（修复包）"
    },
    {
      "name": "healArmor",
      "nameZh": "恢复装甲值",
      "comment": "使用后恢复的装甲值，单位：点",
      "type": "number",
      "required": false,
      "default": 0,
      "options": [],
      "refDatabase": null,
      "scope": "仅装甲修复类消耗品（装甲补片）"
    },
    {
      "name": "energy",
      "nameZh": "恢复能量",
      "comment": "使用后恢复的能量资源点数，单位：点",
      "type": "number",
      "required": false,
      "default": 0,
      "options": [],
      "refDatabase": null,
      "scope": "仅能量类消耗品（能量电池）"
    },
    {
      "name": "desc",
      "nameZh": "描述",
      "comment": "物品的功能描述文本（一般注明恢复数值）",
      "type": "string",
      "required": true,
      "default": "",
      "options": [],
      "refDatabase": null,
      "scope": null
    },
    {
      "name": "price",
      "nameZh": "市场价格",
      "comment": "交易系统中的基础买卖价格，单位：信用点",
      "type": "number",
      "required": true,
      "default": 0,
      "options": [],
      "refDatabase": null,
      "scope": null
    },
    {
      "name": "weight",
      "nameZh": "重量",
      "comment": "单位物品质量，单位：千克（kg），影响载具货舱载重",
      "type": "number",
      "required": true,
      "default": 0,
      "options": [],
      "refDatabase": null,
      "scope": null
    },
    {
      "name": "cargoVolume",
      "nameZh": "货舱体积",
      "comment": "单个物品占用的货舱体积，单位：立方米（m³）",
      "type": "number",
      "required": true,
      "default": 0.01,
      "options": [],
      "refDatabase": null,
      "scope": null
    }
  ]
}
